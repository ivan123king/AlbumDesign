{
  "name": "album-design",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 简易画册排版工具",
  "author": "AlbumDesign",
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:text": "npm run build && node scripts/smoke.mjs --text",
    "smoke:layers": "npm run build && node scripts/smoke.mjs --layers",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
